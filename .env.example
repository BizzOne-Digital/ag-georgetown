# Google Analytics 4 measurement ID (leave blank to disable)
NEXT_PUBLIC_GA_ID=

# Meta (Facebook/Instagram) Pixel ID (leave blank to disable)
NEXT_PUBLIC_META_PIXEL_ID=

# Resend API key for the contact form (https://resend.com)
RESEND_API_KEY=

# Email address that receives contact form submissions
CONTACT_TO_EMAIL=

# --- Database (MongoDB Atlas + Mongoose) ---
# Atlas -> Database -> Connect -> Drivers -> copy the connection string, then
# fill in the real password and database name. Never commit the real value -
# put it in .env.local (gitignored), not here.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# --- Stripe (checkout + webhooks) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Admin panel (/admin) ---
# Single shared password for HTTP Basic Auth - a deliberate stopgap, not a
# full user/permissions system (see middleware.ts). Any username works;
# only the password is checked.
ADMIN_PASSWORD=
